rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function courseOwner(courseId) { return get(/databases/$(database)/documents/publicCourses/$(courseId)).data.ownerUid; }
    function isCourseOwner(courseId) { return signedIn() && request.auth.uid == courseOwner(courseId); }
    function privateAssessment(courseId, assessmentId) { return get(/databases/$(database)/documents/users/$(courseOwner(courseId))/courseProjects/$(courseId)/assessments/$(assessmentId)).data; }
    function privateStudent(courseId, studentId) { return get(/databases/$(database)/documents/users/$(courseOwner(courseId))/courseProjects/$(courseId)/students/$(studentId)).data; }
    function hasValidSession(courseId, assessmentId) { return signedIn() && exists(/databases/$(database)/documents/publicCourses/$(courseId)/assessments/$(assessmentId)/sessions/$(request.auth.uid)); }
    function sessionData(courseId, assessmentId) { return get(/databases/$(database)/documents/publicCourses/$(courseId)/assessments/$(assessmentId)/sessions/$(request.auth.uid)).data; }
    function attemptData(courseId, assessmentId, studentId) { return get(/databases/$(database)/documents/publicCourses/$(courseId)/assessments/$(assessmentId)/attempts/$(studentId)).data; }
    function isTwoStage(courseId, assessmentId) { return privateAssessment(courseId, assessmentId).mode == 'ARGUMENT_TWO_STAGE'; }
    function twoStageSessionClass(courseId, assessmentId) { return sessionData(courseId, assessmentId).className; }
    function twoStageStage(courseId, assessmentId) { return privateAssessment(courseId, assessmentId).classStages[twoStageSessionClass(courseId, assessmentId)].stage; }
    function twoStageSessionMatchesStage(courseId, assessmentId) { return sessionData(courseId, assessmentId).purpose == twoStageStage(courseId, assessmentId); }
    function twoStageRequestedClass(courseId, assessmentId) { return request.resource.data.className; }
    function requestedTwoStage(courseId, assessmentId) { return privateAssessment(courseId, assessmentId).classStages[twoStageRequestedClass(courseId, assessmentId)].stage; }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /publicCourses/{courseId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /classes/{classId} {
        allow read: if true;
        allow create, update, delete: if isCourseOwner(courseId);
      }
      match /materials/{materialId} {
        allow read: if true;
        allow create, update, delete: if isCourseOwner(courseId);
      }
      match /notices/{noticeId} {
        allow read: if true;
        allow create, update, delete: if isCourseOwner(courseId);
      }

      match /assessments/{assessmentId} {
        allow read: if true;
        allow create, update, delete: if isCourseOwner(courseId);

        match /content/{contentId} {
          allow read: if isCourseOwner(courseId)
                      || (hasValidSession(courseId, assessmentId)
                          && (
                            (isTwoStage(courseId, assessmentId)
                             && twoStageSessionMatchesStage(courseId, assessmentId)
                             && twoStageStage(courseId, assessmentId) in ['PHASE2_OPEN','MATERIAL_WINDOW','PHASE3_OPEN'])
                            ||
                            (!isTwoStage(courseId, assessmentId)
                             && privateAssessment(courseId, assessmentId).status == 'OPEN'
                             && attemptData(courseId, assessmentId, sessionData(courseId, assessmentId).studentId).authUid == request.auth.uid)
                          ));
          allow create, update, delete: if isCourseOwner(courseId);
        }

        match /sessions/{sessionId} {
          allow read: if isCourseOwner(courseId) || (signedIn() && sessionId == request.auth.uid);

          allow create: if signedIn()
                        && sessionId == request.auth.uid
                        && request.resource.data.authUid == request.auth.uid
                        && request.resource.data.studentId is string
                        && request.resource.data.studentName is string
                        && request.resource.data.nameKey is string
                        && (
                          (!isTwoStage(courseId, assessmentId)
                           && request.resource.data.accessCodeProof is string
                           && privateAssessment(courseId, assessmentId).status in ['WAITING','OPEN']
                           && request.resource.data.accessCodeProof == privateAssessment(courseId, assessmentId).accessCode
                           && request.resource.data.nameKey == privateStudent(courseId, request.resource.data.studentId).nameKey
                           && privateAssessment(courseId, assessmentId).targetClasses.hasAny([privateStudent(courseId, request.resource.data.studentId).className]))
                          ||
                          (isTwoStage(courseId, assessmentId)
                           && request.resource.data.className is string
                           && request.resource.data.className == privateStudent(courseId, request.resource.data.studentId).className
                           && request.resource.data.nameKey == privateStudent(courseId, request.resource.data.studentId).nameKey
                           && request.resource.data.purpose == requestedTwoStage(courseId, assessmentId)
                           && privateAssessment(courseId, assessmentId).targetClasses.hasAny([request.resource.data.className])
                           && (
                             (requestedTwoStage(courseId, assessmentId) in ['PHASE2_OPEN','PHASE3_OPEN']
                              && request.resource.data.accessCodeProof == privateAssessment(courseId, assessmentId).accessCode)
                             ||
                             (requestedTwoStage(courseId, assessmentId) == 'MATERIAL_WINDOW'
                              && request.resource.data.phase2Submitted == true
                              && attemptData(courseId, assessmentId, request.resource.data.studentId).phase2Status == 'SUBMITTED')
                           ))
                        );

          allow update: if isCourseOwner(courseId)
                        || (signedIn()
                            && sessionId == request.auth.uid
                            && resource.data.authUid == request.auth.uid
                            && request.resource.data.authUid == resource.data.authUid
                            && request.resource.data.studentId == resource.data.studentId
                            && request.resource.data.nameKey == resource.data.nameKey
                            && (
                              (!isTwoStage(courseId, assessmentId)
                               && request.resource.data.accessCodeProof == resource.data.accessCodeProof)
                              ||
                              (isTwoStage(courseId, assessmentId)
                               && request.resource.data.className == resource.data.className
                               && privateAssessment(courseId, assessmentId).targetClasses.hasAny([resource.data.className])
                               && request.resource.data.purpose == privateAssessment(courseId, assessmentId).classStages[resource.data.className].stage
                               && (
                                 (privateAssessment(courseId, assessmentId).classStages[resource.data.className].stage in ['PHASE2_OPEN','PHASE3_OPEN']
                                  && request.resource.data.accessCodeProof == privateAssessment(courseId, assessmentId).accessCode)
                                 ||
                                 (privateAssessment(courseId, assessmentId).classStages[resource.data.className].stage == 'MATERIAL_WINDOW'
                                  && request.resource.data.phase2Submitted == true
                                  && attemptData(courseId, assessmentId, resource.data.studentId).phase2Status == 'SUBMITTED')
                               ))
                            ));
          allow delete: if isCourseOwner(courseId) || (signedIn() && sessionId == request.auth.uid);
        }

        match /attempts/{studentId} {
          allow read: if isCourseOwner(courseId)
                      || (hasValidSession(courseId, assessmentId)
                          && sessionData(courseId, assessmentId).studentId == studentId
                          && (
                            (isTwoStage(courseId, assessmentId)
                             && twoStageSessionMatchesStage(courseId, assessmentId))
                            || privateAssessment(courseId, assessmentId).status == 'WAITING'
                            || resource.data.authUid == request.auth.uid
                          ));

          allow create: if isCourseOwner(courseId)
                        || (hasValidSession(courseId, assessmentId)
                            && sessionData(courseId, assessmentId).studentId == studentId
                            && request.resource.data.studentId == studentId
                            && request.resource.data.authUid == request.auth.uid
                            && (
                              (!isTwoStage(courseId, assessmentId)
                               && ((privateAssessment(courseId, assessmentId).status == 'WAITING' && request.resource.data.status == 'WAITING')
                                   || (privateAssessment(courseId, assessmentId).status == 'OPEN' && request.resource.data.status == 'IN_PROGRESS')))
                              ||
                              (isTwoStage(courseId, assessmentId)
                               && twoStageSessionMatchesStage(courseId, assessmentId)
                               && twoStageStage(courseId, assessmentId) == 'PHASE2_OPEN'
                               && request.resource.data.className == twoStageSessionClass(courseId, assessmentId)
                               && request.resource.data.phase2Status == 'IN_PROGRESS')
                            ));

          allow update: if isCourseOwner(courseId)
                        || (hasValidSession(courseId, assessmentId)
                            && sessionData(courseId, assessmentId).studentId == studentId
                            && request.resource.data.studentId == resource.data.studentId
                            && request.resource.data.authUid == resource.data.authUid
                            && (
                              (!isTwoStage(courseId, assessmentId)
                               && resource.data.status != 'SUBMITTED'
                               && ((resource.data.status == 'WAITING'
                                    && privateAssessment(courseId, assessmentId).status == 'WAITING'
                                    && request.resource.data.status == 'WAITING'
                                    && request.resource.data.authUid == request.auth.uid)
                                   || (resource.data.status == 'WAITING'
                                       && privateAssessment(courseId, assessmentId).status == 'OPEN'
                                       && request.resource.data.status == 'IN_PROGRESS'
                                       && request.resource.data.authUid == request.auth.uid)
                                   || (resource.data.status == 'IN_PROGRESS'
                                       && resource.data.authUid == request.auth.uid
                                       && request.resource.data.authUid == request.auth.uid
                                       && request.resource.data.status in ['IN_PROGRESS','SUBMITTED'])))
                              ||
                              (isTwoStage(courseId, assessmentId)
                               && twoStageSessionMatchesStage(courseId, assessmentId)
                               && resource.data.className == twoStageSessionClass(courseId, assessmentId)
                               && request.resource.data.className == resource.data.className
                               && (
                                 (twoStageStage(courseId, assessmentId) == 'PHASE2_OPEN'
                                  && resource.data.phase2Status != 'SUBMITTED'
                                  && request.resource.data.phase2Status in ['IN_PROGRESS','SUBMITTED']
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase2','phase2Status','phase2SubmittedAt','phase2LastSavedAt','lastSeenAt','updatedAt']))
                                 ||
                                 (twoStageStage(courseId, assessmentId) == 'MATERIAL_WINDOW'
                                  && resource.data.phase2Status == 'SUBMITTED'
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extraMaterials','extraMaterialsUpdatedAt','lastSeenAt','updatedAt']))
                                 ||
                                 (twoStageStage(courseId, assessmentId) == 'PHASE3_OPEN'
                                  && resource.data.phase2Status == 'SUBMITTED'
                                  && request.resource.data.phase3Status in ['IN_PROGRESS','SUBMITTED']
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase3Status','phase3Outline','phase3Essay','phase3StartedAt','phase3SubmittedAt','phase3LastSavedAt','phase3EventLog','phase3FocusLossCount','phase3PasteCount','phase3CopyCount','lastSeenAt','updatedAt']))
                               ))
                            ));

          allow delete: if isCourseOwner(courseId);
        }
      }
    }
  }
}
